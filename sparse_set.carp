(use Array)
(use Uint32)
(use Maybe)

(definterface count (Fn [a] Int))

(doc SparseSet
  "is a high-performance collection that maps integer IDs to values.
It provides $O(1)$ lookup, insertion, and deletion while maintaining contiguous 
storage for cache-friendly iteration.

### Architecture
1. **Sparse Array**: Indexed by the ID. Stores the index into the dense array.
2. **Dense Array**: Stores the original IDs contiguously.
3. **Data Array**: Stores the values contiguously, matching the order of the dense array.
4. **Count**: Tracks the number of active elements.

### Performance
Insertion, deletion, and lookup are all $O(1)$. 
Clear is $O(1)$ (does not drop elements).")
(deftype (SparseSet t)
  [sparse (Array Int)
   dense (Array Int)
   data (Array t)
   count Int])

(defmodule SparseSet
  (defn- panic! [msg] (do (IO.println &(str* "Error: " msg)) (System.exit 1)))

  (doc with-capacity
    "creates a new SparseSet with the specified initial capacity.")
  (defn with-capacity [cap]
    (let [c (if (< cap 1) 1 cap)
          sparse (Array.allocate c)
          dense (Array.allocate c)
          data (Array.allocate c)]
      (do
        (for [i 0 c]
          (do
            (Array.aset-uninitialized! &sparse i -1)
            (Array.aset-uninitialized! &dense i -1)
            (Array.aset-uninitialized! &data i (zero))))
        (SparseSet.init sparse dense data 0))))

  (doc new "creates a new, empty SparseSet with an initial capacity of 8.")
  (defn new [] (SparseSet.with-capacity 8))

  (doc zero "returns an empty SparseSet instance.")
  (defn zero [] (SparseSet.new))
  (implements zero SparseSet.zero)

  (doc length
    "returns the number of active elements in the set. $O(1)$ complexity.")
  (defn length [s] @(SparseSet.count s))
  (implements count SparseSet.length)

  (doc capacity
    "returns the current capacity of the dense storage. $O(1)$ complexity.")
  (defn capacity [s] (Array.length (SparseSet.dense s)))

  (doc sparse-capacity
    "returns the current maximum ID supported by the sparse array.")
  (defn sparse-capacity [s] (Array.length (SparseSet.sparse s)))

  (doc empty? "checks if the set is empty.")
  (defn empty? [s] (= @(SparseSet.count s) 0))
  (implements empty? SparseSet.empty?)

  (doc contains? "checks if the set contains the given ID. $O(1)$ complexity.")
  (defn contains? [s id]
    (let [sparse (SparseSet.sparse s)
          id-idx (Long.to-int (Uint32.to-long id))]
      (if (or (< id-idx 0) (>= id-idx (Array.length sparse)))
        false
        (let [dense-idx @(Array.unsafe-nth sparse id-idx)]
          (if (and (>= dense-idx 0) (< dense-idx @(SparseSet.count s)))
            (= @(Array.unsafe-nth (SparseSet.dense s) dense-idx) id-idx)
            false)))))

  (defn- ensure-sparse-capacity! [s id-idx]
    (let [current (Array.length (SparseSet.sparse s))]
      (when (>= id-idx current)
        (let [suggested-cap (if (= current 0) (inc id-idx) (* current 2))
              new-cap (if (> (inc id-idx) suggested-cap)
                (inc id-idx)
                suggested-cap)
              sparse (SparseSet.sparse s)]
          (for [i current new-cap] (Array.push-back! sparse -1))))))

  (defn- ensure-dense-capacity! [s]
    (let [current (Array.length (SparseSet.dense s))
          count @(SparseSet.count s)]
      (when (>= count current)
        (let [new-cap (if (= current 0) 8 (* current 2))
              dense (SparseSet.dense s)
              data (SparseSet.data s)]
          (do
            (for [i current new-cap]
              (do
                (Array.push-back! dense -1)
                (ignore (Array.push-back! data (zero))))))))))

  (doc insert!
    "inserts a value at the specified ID. Overwrites if the ID already exists. $O(1)$ amortized.")
  (defn insert! [s id val]
    (let [id-idx (Long.to-int (Uint32.to-long id))]
      (do
        (SparseSet.ensure-sparse-capacity! s id-idx)
        (let [sparse (SparseSet.sparse s)
              dense (SparseSet.dense s)
              data (SparseSet.data s)
              count @(SparseSet.count s)
              dense-idx @(Array.unsafe-nth sparse id-idx)]
          (if (and (>= dense-idx 0)
                   (< dense-idx count)
                   (= @(Array.unsafe-nth dense dense-idx) id-idx))
            ;; Update existing
            (Array.aset! data dense-idx val)
            ;; Insert new
            (do
              (SparseSet.ensure-dense-capacity! s)
              (let [new-idx @(SparseSet.count s)]
                (do
                  (Array.aset! dense new-idx id-idx)
                  (Array.aset! data new-idx val)
                  (Array.aset! sparse id-idx new-idx)
                  (SparseSet.set-count! s (inc new-idx))))))))))

  (doc remove! "removes the element at the specified ID. $O(1)$ complexity.")
  (defn remove! [s id]
    (let [id-idx (Long.to-int (Uint32.to-long id))
          sparse (SparseSet.sparse s)]
      (if (or (< id-idx 0) (>= id-idx (Array.length sparse)))
        ()
        (let [dense-idx @(Array.unsafe-nth sparse id-idx)
              dense (SparseSet.dense s)
              data (SparseSet.data s)
              count @(SparseSet.count s)]
          (if (and (>= dense-idx 0)
                   (< dense-idx count)
                   (= @(Array.unsafe-nth dense dense-idx) id-idx))
            ;; Swap with last
            (let [last-idx (dec count)
                  last-id @(Array.unsafe-nth dense last-idx)]
              (do
                ;; Move last to current slot
                (Array.aset! dense dense-idx last-id)
                (Array.aset! data dense-idx @(Array.unsafe-nth data last-idx))
                ;; Update sparse map for the moved element
                (Array.aset! sparse last-id dense-idx)
                ;; Mark removed ID as empty in sparse
                (Array.aset! sparse id-idx -1)
                ;; Dec count
                (SparseSet.set-count! s last-idx)))
            ())))))

  (doc get "returns a copy of the value at the given ID.")
  (defn get [s id]
    (let [id-idx (Long.to-int (Uint32.to-long id))
          sparse (SparseSet.sparse s)]
      (if (or (< id-idx 0) (>= id-idx (Array.length sparse)))
        (Maybe.Nothing)
        (let [dense-idx @(Array.unsafe-nth sparse id-idx)
              dense (SparseSet.dense s)
              count @(SparseSet.count s)]
          (if (and (>= dense-idx 0)
                   (< dense-idx count)
                   (= @(Array.unsafe-nth dense dense-idx) id-idx))
            (Maybe.Just @(Array.unsafe-nth (SparseSet.data s) dense-idx))
            (Maybe.Nothing))))))

  (doc get-ptr "returns a pointer to the value at the given ID.")
  (defn get-ptr [s id]
    (let [id-idx (Long.to-int (Uint32.to-long id))
          sparse (SparseSet.sparse s)]
      (if (or (< id-idx 0) (>= id-idx (Array.length sparse)))
        (Maybe.Nothing)
        (let [dense-idx @(Array.unsafe-nth sparse id-idx)
              dense (SparseSet.dense s)
              count @(SparseSet.count s)]
          (if (and (>= dense-idx 0)
                   (< dense-idx count)
                   (= @(Array.unsafe-nth dense dense-idx) id-idx))
            (Maybe.Just
              (Pointer.address (Array.unsafe-nth (SparseSet.data s) dense-idx)))
            (Maybe.Nothing))))))

  (doc clear! "removes all elements from the set. $O(1)$ complexity. 
Note: Elements are NOT dropped. Reusing the set will eventually overwrite them.")
  (defn clear! [s] (SparseSet.set-count! s 0))

  (doc with-ptr
    "executes a function f with a pointer to the value at the given ID.")
  (defn with-ptr [s id f]
    (match (SparseSet.get-ptr s id) (Maybe.Just ptr) (~f ptr) (Maybe.Nothing) ()))

  (doc for-each "iterates over all active elements in the set.")
  (defn for-each [f s]
    (let [data (SparseSet.data s)
          len @(SparseSet.count s)]
      (for [i 0 len] (~f (Array.unsafe-nth data i)))))

  (doc reduce "reduces the active elements in the set to a single value.")
  (defn reduce [f acc s]
    (let [data (SparseSet.data s)
          len @(SparseSet.count s)
          res acc]
      (do (for [i 0 len] (set! res (~f res (Array.unsafe-nth data i)))) res)))

  (doc any? "checks if any active element in the set satisfies the predicate.")
  (defn any? [f s]
    (let [data (SparseSet.data s)
          len @(SparseSet.count s)
          res false]
      (do
        (for [i 0 len]
          (when (~f (Array.unsafe-nth data i)) (do (set! res true) (break))))
        res)))

  (doc all? "checks if all active elements in the set satisfy the predicate.")
  (defn all? [f s]
    (let [data (SparseSet.data s)
          len @(SparseSet.count s)
          res true]
      (do
        (for [i 0 len]
          (unless (~f (Array.unsafe-nth data i)) (do (set! res false) (break))))
        res)))

  (doc id-at-idx "returns the ID at the specified dense index.")
  (defn id-at-idx [s idx]
    (if (and (>= idx 0) (< idx @(SparseSet.count s)))
      (Maybe.Just
        (Uint32.from-long
          (Long.from-int @(Array.unsafe-nth (SparseSet.dense s) idx))))
      (Maybe.Nothing)))

  (doc value-at-idx "returns a copy of the value at the specified dense index.")
  (defn value-at-idx [s idx]
    (if (and (>= idx 0) (< idx @(SparseSet.count s)))
      (Maybe.Just @(Array.unsafe-nth (SparseSet.data s) idx))
      (Maybe.Nothing)))

  (doc value-ptr-at-idx
    "returns a pointer to the value at the specified dense index.")
  (defn value-ptr-at-idx [s idx]
    (if (and (>= idx 0) (< idx @(SparseSet.count s)))
      (Maybe.Just (Pointer.address (Array.unsafe-nth (SparseSet.data s) idx)))
      (Maybe.Nothing)))

  (doc str "returns a string representation of the set.")
  (defn str [s]
    (str* "SparseSet(len: "
          (Int.str @(SparseSet.count s))
          ", cap: "
          (Int.str (SparseSet.capacity s))
          ")"))
  (implements str SparseSet.str))
